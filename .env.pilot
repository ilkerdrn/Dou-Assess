POSTGRES_DB=dou_assess
POSTGRES_USER=dou_assess
POSTGRES_PASSWORD=CHANGE_ME_AUTOGENERATED
HTTP_PORT=8080
APP_ENV=pilot
AUTH_REQUIRED=false
AUTH_PROVIDER=pilot
PILOT_ADMIN_EMAIL=pilot-admin@local

# Upload / document safety
MAX_UPLOAD_MB=20
MAX_BATCH_UPLOAD_MB=60
MAX_BATCH_FILES=20
MAX_REQUEST_MB=64
MAX_PDF_PAGES=120
MAX_IMAGE_MEGAPIXELS=40
MAX_XLSX_UNCOMPRESSED_MB=80
MAX_XLSX_MEMBERS=5000

# Pilot load tests should not be distorted by application rate limiting.
# Production compose forces this on.
RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_PER_MINUTE=600
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# PostgreSQL pool / timeout hardening
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
AUTH_LAST_SEEN_WRITE_SECONDS=300
JWKS_CACHE_LIFESPAN_SECONDS=600
JWKS_HTTP_TIMEOUT_SECONDS=5

SECURITY_HEADERS=true
REQUIRE_HTTPS=false
STRICT_PRODUCTION_SECURITY=true
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=
PUBLIC_HOSTNAME=
ALLOWED_HOSTS=

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ALLOWED_CLIENT_IDS=
ENTRA_REQUIRED_SCOPES=
ENTRA_LOGIN_SCOPES=
ENTRA_REDIRECT_URI=
ENTRA_REQUIRE_DELEGATED_USER=true
ENTRA_AUTO_LINK_BY_EMAIL=false

# Yalnız kontrollü pilot/UAT ortamında.
PILOT_AUTH_ENABLED=true
PILOT_DEMO_ENABLED=true

# 6.68 Operations & Automation
JOB_POLL_SECONDS=2
JOB_STALE_MINUTES=30
SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_LOOKAHEAD_DAYS=7
EVIDENCE_INTEGRITY_INTERVAL_HOURS=24
BACKUP_AUTOMATION_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# --- OBS ile giriş (pilot düzeninde) -------------------------------------------------
# Açmak için: AUTH_REQUIRED=true ve AUTH_PROVIDER=obs yapın, aşağıdakileri doldurun.
# OBS_JWT_SECRET ve STUDENT_LINK_SECRET için:  openssl rand -base64 48 | tr -d '\n'
# DİKKAT: Giriş formu OBS şifresini gönderir; kullanıcılar gerçek şifreyle girmeden önce HTTPS açın.
# AUTH_REQUIRED=true
# AUTH_PROVIDER=obs
OBS_PROLIZ_ENABLED=false
OBS_PROLIZ_BASE_URL=https://portalapi.dogus.edu.tr
OBS_PROLIZ_USERNAME=
OBS_PROLIZ_PASSWORD=
OBS_JWT_SECRET=
OBS_JWT_EXPIRES_MINUTES=480
# İlk yönetici(ler): OBS ile ilk girişte otomatik admin olur (Proliz'deki EPOSTA ile birebir aynı).
BOOTSTRAP_ADMIN_EMAILS=
STUDENT_LINK_SECRET=
STUDENT_APPEAL_DAYS=7
OUTCOME_TERM=Öğrenim
SCAN_RETENTION_DAYS=1460
