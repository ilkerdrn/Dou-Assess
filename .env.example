# DOU Assess 6.18 Complete Assessment Engine local/pilot example
POSTGRES_DB=dou_assess
POSTGRES_USER=dou_assess
POSTGRES_PASSWORD=CHANGE_ME
HTTP_PORT=8080
APP_ENV=pilot
AUTH_REQUIRED=false
AUTH_PROVIDER=pilot
PILOT_ADMIN_EMAIL=pilot-admin@local
MAX_UPLOAD_MB=20
MAX_BATCH_UPLOAD_MB=60
MAX_BATCH_FILES=20
MAX_REQUEST_MB=64
MAX_PDF_PAGES=120
MAX_IMAGE_MEGAPIXELS=40
MAX_XLSX_UNCOMPRESSED_MB=80
RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_PER_MINUTE=600
UPLOAD_RATE_LIMIT_PER_MINUTE=30
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_STATEMENT_TIMEOUT_MS=30000
SECURITY_HEADERS=true
REQUIRE_HTTPS=false
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=

# Veri yaşam döngüsü
EVIDENCE_RETENTION_DAYS=1825
STUDENT_DATA_RETENTION_DAYS=2555
PRIVACY_CONTACT=

# OBS sonuç geri gönderim adaptörü (opsiyonel)
OBS_WRITEBACK_ENABLED=false
OBS_RESULTS_ENDPOINT=
OBS_RESULTS_TOKEN=
OBS_RESULTS_TIMEOUT_SECONDS=15

# Proliz OBS read-only veri çekme (opsiyonel, kampüs ağından erişilebilir)
OBS_PROLIZ_ENABLED=false
OBS_PROLIZ_BASE_URL=https://portalapi.dogus.edu.tr
OBS_PROLIZ_USERNAME=
OBS_PROLIZ_PASSWORD=
OBS_PROLIZ_TIMEOUT_SECONDS=20

# 6.68 Operations & Automation
JOB_POLL_SECONDS=2
JOB_STALE_MINUTES=30
SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_LOOKAHEAD_DAYS=7
EVIDENCE_INTEGRITY_INTERVAL_HOURS=24
BACKUP_AUTOMATION_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
